# =============================================================================
# ArthSetu Monorepo - Environment Variable Template
# Smart India Hackathon Problem Statement 26092 (Ministry of Social Justice and Empowerment)
# =============================================================================

# ── Backend Configuration (Python FastAPI) ───────────────────────────────────
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (Public - used for client requests and auth)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase Service Role Key (SECRET - Backend ONLY, administrative operations)
# WARNING: NEVER commit or expose this key to frontend/client applications!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL Direct Connection String (Backend ONLY, for direct SQL clients/migrations)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ── AI Intelligence Layer & RAG (Step 3) ─────────────────────────────────────
# Groq API Key (Free tier: ~30 req/min, 14,400 req/day from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_RATE_LIMIT_PER_MINUTE=60

# Embeddings: Local sentence-transformers (all-MiniLM-L6-v2) - NO API key needed!
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ── OpenRouteService & Maps (Step 5) ─────────────────────────────────────────
# Free tier key: 2,500 requests/day from https://openrouteservice.org
ORS_API_KEY=your_openrouteservice_api_key_here
NOMINATIM_USER_AGENT=ArthSetu-SIH26092/1.0 (contact@arthsetu.gov.in)

# ── Security & Administration (Step 6) ───────────────────────────────────────
ADMIN_SECRET_KEY=your_admin_secret_key_here

# CORS Allowed Origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173,exp://localhost:8081,*

# ── Mobile Configuration (React Native with Expo) ─────────────────────────────
# Exposed to client-side code via Expo's EXPO_PUBLIC_ prefix
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
