# UdyamNex Backend Configuration (FastAPI)
# SIH Problem Statement 26092 - Ministry of Social Justice and Empowerment

# Environment
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Used only by the backend for administrative operations (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Supabase public anonymous key (for client authentication verification)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostgreSQL Direct Connection String (Backend ONLY, for direct DB pooling)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# AI Intelligence Layer (Groq API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Geocoding & Routing (OpenRouteService & OSM Nominatim)
ORS_API_KEY=your_openrouteservice_api_key_here
NOMINATIM_USER_AGENT=UdyamNex-SIH26092/1.0 (contact@udyamnex.gov.in)

# Security & Governance
ADMIN_SECRET_KEY=your_admin_secret_key_here
AI_RATE_LIMIT_PER_MINUTE=60

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173,exp://localhost:8081,*
