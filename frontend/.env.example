# Frontend Environment Variables — UdyamNex
# Copy this file to .env and fill in your values

# Base URL of the deployed FastAPI backend (no trailing slash)
# Local development:
VITE_API_URL=http://127.0.0.1:8000
# Render deployment example:
# VITE_API_URL=https://udyamnex-backend.onrender.com

# OpenRouteService / HeiGIT API Key (Optional for directions API)
# Current endpoint: https://api.heigit.org/openrouteservice/v2/directions/driving-car/geojson
# Note: If omitted or quota exceeded, UdyamNex automatically uses public routing fallbacks.
VITE_OPENROUTESERVICE_API_KEY=
