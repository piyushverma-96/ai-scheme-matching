# UdyamNex Mobile (React Native / Expo) Configuration
# SIH Problem Statement 26092 - Ministry of Social Justice and Empowerment

# FastAPI Backend Base URL
# For local Android emulator, use: http://10.0.2.2:8000
# For local iOS simulator or Web, use: http://localhost:8000
# For physical phone via Expo Go on Wi-Fi, use: http://<your_lan_ip>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase Public Anonymous Configuration
# (SAFE for mobile/client: Supabase uses Row Level Security & Auth tokens)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# NEVER expose SUPABASE_SERVICE_ROLE_KEY here!
